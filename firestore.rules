rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role() { return signedIn() ? userDoc().role : ''; }
    function sameDepartment(dept) { return signedIn() && userDoc().department == dept; }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || role() in ['facility_manager', 'principal']);
      // Only trusted Admin SDK provisioning can create/change roles. Client-side writes are blocked.
      allow create, update, delete: if false;
    }
    match /requests/{requestId} {
      allow read: if signedIn() && (
        resource.data.createdBy == request.auth.uid ||
        role() in ['facility_manager', 'principal'] ||
        (role() == 'hod' && sameDepartment(resource.data.department))
      );
      // All state changes go through authenticated Cloud Functions so the approval order is enforced server-side.
      allow create, update, delete: if false;
    }
  }
}